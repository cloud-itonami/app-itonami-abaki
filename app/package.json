{
  "name": "@itonami/abaki-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.abaki",
    "title": "Abaki",
    "storageKey": "itonami.abaki.v1",
    "description": "独占・チョークポイントの観察を、この端末で試します。事業者の特徴を入力すると Chokepoint Index（CI）を計算し、迂回先（route around）と生存ツリーを示します。外部へは何も送信しません。",
    "cljsSources": [
      "../src"
    ],
    "storeId": "network.itonami.abaki"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
